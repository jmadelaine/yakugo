# `pnpm dev` runs against the example-repo folder on disk and needs no GitHub values
# (it sets LOCAL_DATA_DIR itself; this file is optional). `pnpm dev:github` runs
# against the GitHub repo below and needs everything in this file.
# Do not set LOCAL_DATA_DIR here: it would make `pnpm dev:github` use the local folder.
#
# Local mode signs you in as your OS user; override with LOCAL_USER.
# LOCAL_USER=writer

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Authorization callback URL: <APP_URL>/auth/callback, e.g. http://localhost:5173/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string, 32+ characters. Used to encrypt the session cookie.
SESSION_SECRET=

# Repository that holds the translations
GITHUB_REPO=owner/repo
BASE_BRANCH=main
# Defaults used when the repo has no yakugo.yaml: one project in this directory
# with <locale>.json files, and the locale shown in the first column.
LOCALES_DIR=locales
SOURCE_LOCALE=en

# Server
PORT=8787
# Where the browser app runs (Vite dev server in development)
APP_URL=http://localhost:5173
